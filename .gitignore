# ==========================================================
# pm-team · 多 agent 协作开发项目（Django 5.2 + DRF 后端 / Vue3 + Element Plus 前端）
# 规则基于 2026-10 基线勘察：
#   dev/.venv                  Python 虚拟环境
#   dev/pgdata                 本地 PostgreSQL 集群数据目录
#   dev/frontend/node_modules  npm 依赖
#   dev/frontend/dist          Vite 构建产物
#   dev/backend/media          后端运行时上传目录
#   dev/backend/.env.example   环境变量模板（保留纳入，真实 .env 不纳入）
# ==========================================================

# ---- Python / Django ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 数据库 ----
pgdata/
*.sqlite3
*.sqlite

# ---- Node / 前端构建产物 ----
node_modules/
dist/
dist-electron/

# ---- 运行时上传物 / 日志 ----
media/
uploads/
logs/
*.log

# ---- 密钥与环境变量（模板 .env.example 保留）----
.env
.env.local
.env.*.local

# ---- 编辑器与系统文件 ----
.DS_Store
.idea/
.vscode/
.claude/settings.local.json
*.swp

# ---- macOS 同步盘产生的重复副本（「文件名(1)」形态，2026-10-27 清理批新增）----
*(1).*
