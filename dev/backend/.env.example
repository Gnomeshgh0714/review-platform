# 审稿协作平台 - 环境变量模板
# 复制为 backend/.env 后填写（settings.py 启动时自动加载，已有环境变量优先）

# ---- Django ----
# 生产环境务必换成随机长字符串（python -c "import secrets; print(secrets.token_urlsafe(60))"）
DJANGO_SECRET_KEY=change-me-in-production
# 本地开发保持 True；settings 兑底已改为 False（V1.2 一般#13），
# 未设置时以安全默认（非调试模式）运行
DJANGO_DEBUG=True
# 是否信任反向代理的 X-Forwarded-For（V1.2 建议#12）：
# 仅在部署于 Nginx 等可信代理之后时设 True，否则客户端可伪造
# 知识库访问审计的 IP 字段；默认 False
DJANGO_TRUST_X_FORWARDED_FOR=False

# ---- PostgreSQL ----
# 本地默认集群（dev/pgdata）的连接参数，按需覆盖
DJANGO_DB_NAME=review_platform
DJANGO_DB_USER=review_user
DJANGO_DB_PASSWORD=review2026
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# ---- AI 审稿（apps/forms/ai_review.py）----
# 火山方舟 API Key，仅环境变量注入，无代码内兜底；不配置则 AI 审稿功能报错但平台其余功能可用
REVIEWER_LLM_API_KEY=
# 可选：模型名，默认 glm-latest
REVIEWER_LLM_MODEL=glm-latest

# ---- CORS（#016 安全项2）----
# 生产环境的前端来源，逗号分隔追加进白名单（本地开发已内置 http://localhost:5173 与
# http://127.0.0.1:5173，无需重复配置；不配置则仅允许本地 Vite dev server 跨域）。
# 同源反代部署（前后端同一域名，见 DEPLOY.md）不跨域，可不配
# 例：CORS_ALLOWED_ORIGINS=https://review.example.com,https://admin.example.com
# CORS_ALLOWED_ORIGINS=

# ---- 生产部署批（#023）新增键 ----
# ALLOWED_HOSTS：逗号分隔；默认回落 localhost,127.0.0.1（已去除 '*' 通配）。
# 生产必填，配公网域名，例：DJANGO_ALLOWED_HOSTS=review.example.com
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF 信任来源：逗号分隔、含 scheme；默认空。公网域名下使用 admin 的
# POST 必配，否则浏览器登录 admin 提交表单即 403，例：
# DJANGO_CSRF_TRUSTED_ORIGINS=https://review.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=

# 反代 TLS 终止信任头：默认 None 不启用；部署在可信反代（自动配发
# X-Forwarded-Proto 头）之后时启用，格式与 Django 文档一致：
# DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# DJANGO_SECURE_PROXY_SSL_HEADER=

# 限流档位（D-4）：默认 10/min 与 50/day 保持现值；生产可按登录频次放宽
# THROTTLE_LOGIN_MINUTE=10/min
# THROTTLE_LOGIN_DAILY=50/day

# Redis 缓存（D-2 机制预留）：默认不设（locmem，单实例演示部署够用）；
# gunicorn 多 worker 部署必设，否则限流计数各进程独立会稀释限流效果
# REDIS_URL=redis://localhost:6379/1

# ---- T-02 邮件（#023 路线A：同步 SMTP）----
# 默认 console 后端（邮件打印到后端日志，本地开发零配置零外发）；
# 生产 SMTP 时将后端换为 smtp 并填整组 SMTP 参数
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=notify@example.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=webmaster@localhost

# ---- bootstrap_dev 演示账号密码 ----
# python manage.py bootstrap_dev 创建演示用户时使用的密码，默认 Demo@2026
BOOTSTRAP_PASSWORD=Demo@2026

# ---- Celery（预留占位，当前未接线：定时任务以 process_scheduled 管理命令 + cron 替代，见 T-19 决策记录；T-02 邮件已走同步 SMTP 路线（#023 路线A），亦不经 Celery）----
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
