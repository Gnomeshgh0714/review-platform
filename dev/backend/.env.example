# 审稿协作平台 - 环境变量模板
# 复制为 backend/.env 后填写（settings.py 启动时自动加载，已有环境变量优先）

# ---- Django ----
# 生产环境务必换成随机长字符串（python -c "import secrets; print(secrets.token_urlsafe(60))"）
DJANGO_SECRET_KEY=change-me-in-production
# 本地开发保持 True；settings 兑底已改为 False（V1.2 一般#13），
# 未设置时以安全默认（非调试模式）运行
DJANGO_DEBUG=True

# ---- PostgreSQL ----
# 本地默认集群（dev/pgdata）的连接参数，按需覆盖
DJANGO_DB_NAME=review_platform
DJANGO_DB_USER=review_user
DJANGO_DB_PASSWORD=review2026
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# ---- AI 审稿（apps/forms/ai_review.py）----
# 火山方舟 API Key，仅环境变量注入，无代码内兜底；不配置则 AI 审稿功能报错但平台其余功能可用
REVIEWER_LLM_API_KEY=
# 可选：模型名，默认 glm-latest
REVIEWER_LLM_MODEL=glm-latest

# ---- CORS（#016 安全项2）----
# 生产环境的前端来源，逗号分隔追加进白名单（本地开发已内置 http://localhost:5173 与
# http://127.0.0.1:5173，无需重复配置；不配置则仅允许本地 Vite dev server 跨域）
# 例：CORS_ALLOWED_ORIGINS=https://review.example.com,https://admin.example.com
# CORS_ALLOWED_ORIGINS=

# ---- bootstrap_dev 演示账号密码 ----
# python manage.py bootstrap_dev 创建演示用户时使用的密码，默认 Demo@2026
BOOTSTRAP_PASSWORD=Demo@2026

# ---- Celery（预留，当前未接线：异步任务以 process_scheduled 管理命令 + cron 替代，见 T-19 决策记录）----
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
